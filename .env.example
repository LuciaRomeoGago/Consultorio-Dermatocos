# Copiar como .env.local (local) o cargar en Cloudflare Pages → Settings → Variables.
# Están en Supabase → Project Settings → API. La "anon"/"publishable" key es pública; nunca pongas la service_role.
# La URL va sola, sin /rest/v1 al final.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
